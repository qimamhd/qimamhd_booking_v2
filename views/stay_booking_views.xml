<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_stay_booking_tree" model="ir.ui.view"><field name="name">qimam.stay.booking.tree</field><field name="model">qimam.stay.booking</field><field name="arch" type="xml">
<tree decoration-info="state == 'confirmed'" decoration-warning="state == 'hold'" decoration-success="state == 'checked_in'" decoration-muted="state in ('checked_out','cancelled')">
<field name="name"/><field name="resource_id"/><field name="partner_id"/><field name="checkin_date"/><field name="checkout_date"/><field name="nights"/><field name="amount_total"/><field name="financial_status"/><field name="state"/>
</tree></field></record>
<record id="view_stay_booking_calendar" model="ir.ui.view"><field name="name">qimam.stay.booking.calendar</field><field name="model">qimam.stay.booking</field><field name="arch" type="xml">
<calendar string="مخطط الإقامة" date_start="checkin_date" date_stop="checkout_date" color="resource_id" mode="month" quick_add="false">
<field name="name"/><field name="resource_id"/><field name="partner_id"/><field name="state"/>
</calendar></field></record>
<record id="view_stay_booking_form" model="ir.ui.view"><field name="name">qimam.stay.booking.form</field><field name="model">qimam.stay.booking</field><field name="arch" type="xml">
<form string="حجز إقامة"><header><button name="action_hold" type="object" string="حجز مؤقت" states="draft"/><button name="action_confirm" type="object" string="تأكيد" states="draft,hold" class="oe_highlight"/><button name="action_checkin" type="object" string="تسجيل الدخول" states="confirmed" class="oe_highlight"/><button name="action_checkout" type="object" string="تسجيل المغادرة" states="checked_in" class="oe_highlight"/><button name="action_open_cancel_wizard" type="object" string="إلغاء مضبوط" states="draft,hold,confirmed"/><button name="action_reopen_cancelled" type="object" string="إعادة فتح" states="cancelled"/><field name="state" widget="statusbar" statusbar_visible="draft,hold,confirmed,checked_in,checked_out,cancelled"/></header>
<sheet><field name="company_id" invisible="1"/><div class="oe_button_box" name="button_box"><button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o"><field name="invoice_count" widget="statinfo" string="الفواتير"/></button></div><div class="oe_title"><label for="name" string="رقم الحجز"/><h1><field name="name"/></h1></div>
<group><group string="الإقامة"><field name="resource_id" options="{'no_create':True}"/><field name="checkin_date"/><field name="checkout_date"/><field name="nights" readonly="1"/></group>
<group string="الضيف"><field name="partner_id"/><field name="adults"/><field name="children"/></group></group>
<group><group string="السعر"><field name="price_per_night"/><field name="room_tax_ids" widget="many2many_tags"/><field name="amount_untaxed" readonly="1"/><field name="amount_tax" readonly="1"/><field name="amount_total" readonly="1"/></group><group string="الحالة المالية"><field name="financial_status" readonly="1"/><field name="invoice_progress" widget="progressbar" readonly="1"/><field name="amount_invoiced" readonly="1"/><field name="amount_credited" readonly="1"/><field name="amount_paid" readonly="1"/><field name="amount_due" readonly="1"/><field name="hold_until" attrs="{'invisible':[('state','!=','hold')]}"/></group></group><group><button name="action_create_invoice" type="object" string="إنشاء فاتورة" class="oe_highlight" attrs="{'invisible':[('state','in',['cancelled'])]}"/><button name="action_open_reversal_wizard" type="object" string="عكس فاتورة" attrs="{'invisible':[('invoice_count','=',0)]}"/></group>
<notebook><page string="الإلغاء" attrs="{'invisible':[('state','!=','cancelled')]}"><field name="cancellation_reason" readonly="1"/><field name="cancelled_by" readonly="1"/><field name="cancelled_at" readonly="1"/></page><page string="ملاحظات"><field name="note" placeholder="طلبات أو ملاحظات الإقامة..."/></page></notebook>
</sheet><div class="oe_chatter"><field name="message_follower_ids" widget="mail_followers"/><field name="activity_ids" widget="mail_activity"/><field name="message_ids" widget="mail_thread"/></div></form>
</field></record>
<record id="action_stay_booking" model="ir.actions.act_window"><field name="name">مخطط الغرف والإقامات</field><field name="res_model">qimam.stay.booking</field><field name="view_mode">calendar,tree,form</field><field name="context">{}</field></record>
</odoo>