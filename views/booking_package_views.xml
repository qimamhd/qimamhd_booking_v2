<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_qimam_package_form" model="ir.ui.view">
  <field name="name">qimam.booking.package.form</field><field name="model">qimam.booking.package</field>
  <field name="arch" type="xml"><form><sheet>
   <div class="oe_title"><h1><field name="name"/></h1></div>
   <field name="description" placeholder="وصف مختصر للباقة..."/>
   <field name="line_ids"><tree editable="bottom"><field name="service_id"/><field name="quantity"/></tree></field>
  </sheet></form></field>
 </record>
 <record id="view_qimam_package_tree" model="ir.ui.view">
  <field name="name">qimam.booking.package.tree</field><field name="model">qimam.booking.package</field>
  <field name="arch" type="xml"><tree><field name="name"/><field name="active"/></tree></field>
 </record>
 <record id="action_qimam_package" model="ir.actions.act_window">
  <field name="name">الباقات</field><field name="res_model">qimam.booking.package</field><field name="view_mode">tree,form</field>
 </record>
</odoo>
