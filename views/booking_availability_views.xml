<?xml version="1.0" encoding="utf-8"?>
<odoo><record id="view_booking_availability_form" model="ir.ui.view"><field name="name">qimam.booking.availability.wizard.form</field><field name="model">qimam.booking.availability.wizard</field><field name="arch" type="xml">
<form string="توفر القاعات" create="false"><header><button name="action_previous" type="object" string="‹ اليوم السابق"/><button name="action_refresh" type="object" string="تحديث" class="oe_highlight"/><button name="action_next" type="object" string="اليوم التالي ›"/></header><sheet>
<div class="oe_title"><h1>توفر القاعات</h1><div class="text-muted">قرار الحجز في شاشة واحدة، بدون تفاصيل مشتتة.</div></div><group><group><field name="booking_date"/></group><group><field name="hall_id" options="{'no_create':True}"/><field name="min_capacity"/></group></group>
<div class="alert alert-info" role="alert"><field name="recommendation" readonly="1" nolabel="1"/></div><group><button name="action_quick" type="object" string="حجز جديد" class="oe_highlight"/></group>
<field name="line_ids" nolabel="1"><tree create="false" edit="false" delete="false" decoration-success="status == 'available'" decoration-warning="status == 'hold'" decoration-info="status in ('confirmed','preparing')" decoration-muted="status in ('event','completed')">
<field name="hall_id"/><field name="capacity"/><field name="period_id"/><field name="status"/><field name="booking_id"/><button name="action_open" type="object" string="فتح" icon="fa-arrow-left"/></tree></field>
</sheet></form></field></record><record id="action_booking_availability" model="ir.actions.act_window"><field name="name">توفر القاعات</field><field name="res_model">qimam.booking.availability.wizard</field><field name="view_mode">form</field><field name="target">current</field></record></odoo>