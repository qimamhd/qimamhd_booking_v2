<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="res_config_settings_view_form_booking" model="ir.ui.view">
  <field name="name">res.config.settings.view.form.qimam.booking</field>
  <field name="model">res.config.settings</field>
  <field name="inherit_id" ref="base.res_config_settings_view_form"/>
  <field name="arch" type="xml">
   <xpath expr="//div[hasclass('settings')]" position="inside">
    <div class="app_settings_block" data-string="Qimam Booking" string="Qimam Booking">
     <h2>إعدادات الحجوزات</h2>
     <div class="row mt16 o_settings_container">
      <div class="col-12 col-lg-6 o_setting_box">
       <div class="o_setting_left_pane"/>
       <div class="o_setting_right_pane">
        <label for="booking_invoice_policy"/><div class="text-muted">اختر سياسة الفوترة دون حشر خيارات مالية داخل شاشة الحجز.</div>
        <field name="booking_invoice_policy"/>
       </div>
      </div>
      <div class="col-12 col-lg-6 o_setting_box">
       <div class="o_setting_left_pane"/>
       <div class="o_setting_right_pane">
        <label for="booking_hold_hours"/><div class="text-muted">مدة صلاحية الحجز المؤقت.</div>
        <field name="booking_hold_hours"/>
       </div>
      </div>
     </div>
    </div>
   </xpath>
  </field>
 </record>
</odoo>
