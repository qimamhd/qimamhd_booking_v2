<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_stay_invoice_wizard" model="ir.ui.view"><field name="name">qimam.stay.invoice.wizard.form</field><field name="model">qimam.stay.invoice.wizard</field><field name="arch" type="xml"><form string="فاتورة الإقامة"><group><field name="stay_id"/><field name="invoice_type"/><field name="deposit_percent" attrs="{'invisible':[('invoice_type','!=','deposit')]}"/><field name="already_invoiced_percent" readonly="1"/><field name="invoice_percent" readonly="1"/><field name="preview_amount" readonly="1"/></group><footer><button name="action_create_invoice" type="object" string="إنشاء مسودة الفاتورة" class="btn-primary"/><button special="cancel" string="إغلاق"/></footer></form></field></record>
 <record id="view_stay_reversal_wizard" model="ir.ui.view"><field name="name">qimam.stay.reversal.wizard.form</field><field name="model">qimam.stay.reversal.wizard</field><field name="arch" type="xml"><form string="عكس فاتورة الإقامة"><group><field name="stay_id"/><field name="invoice_id"/><field name="refund_method"/><field name="reason"/></group><footer><button name="action_reverse" type="object" string="تنفيذ العكس" class="btn-primary"/><button special="cancel" string="إغلاق"/></footer></form></field></record>
 <record id="view_stay_cancel_wizard" model="ir.ui.view"><field name="name">qimam.stay.cancel.wizard.form</field><field name="model">qimam.stay.cancel.wizard</field><field name="arch" type="xml"><form string="إلغاء الإقامة"><group><field name="stay_id"/><field name="reason"/><field name="cancel_draft_invoices"/><field name="draft_invoice_count" readonly="1"/><field name="posted_document_count" readonly="1"/><field name="amount_paid" readonly="1"/><field name="amount_due" readonly="1"/></group><footer><button name="action_cancel" type="object" string="إلغاء الحجز" class="btn-danger" confirm="سيتم تحرير الغرفة بعد نجاح الضوابط المالية. هل تريد المتابعة؟"/><button special="cancel" string="رجوع"/></footer></form></field></record>
</odoo>