<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_booking_reversal_wizard" model="ir.ui.view">
  <field name="name">qimam.booking.reversal.wizard.form</field>
  <field name="model">qimam.booking.reversal.wizard</field>
  <field name="arch" type="xml">
   <form string="عكس / إشعار دائن">
    <group><field name="booking_id"/><field name="invoice_id"/><field name="amount_paid"/></group>
    <group><field name="refund_method"/><field name="reason"/></group>
    <div class="alert alert-warning" role="alert">
     هذا الإجراء محاسبي فقط ولا يلغي الحجز أو يحرر القاعة تلقائيًا.
    </div>
    <footer><button name="action_reverse" type="object" string="تنفيذ الإجراء المالي" class="btn-primary"/><button string="رجوع" special="cancel" class="btn-secondary"/></footer>
   </form>
  </field>
 </record>
</odoo>
