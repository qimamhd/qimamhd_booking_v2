<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_booking_quick_wizard" model="ir.ui.view">
  <field name="name">qimam.booking.quick.wizard.form</field><field name="model">qimam.booking.quick.wizard</field>
  <field name="arch" type="xml"><form string="حجز سريع">
   <group><field name="partner_id"/><field name="booking_date"/><field name="hall_id"/><field name="period_ids" widget="many2many_tags"/><field name="guest_count"/></group>
   <field name="note" placeholder="ملاحظة اختيارية..."/>
   <footer><button name="action_create_booking" type="object" string="إنشاء الحجز" class="btn-primary"/><button string="إغلاق" special="cancel" class="btn-secondary"/></footer>
  </form></field>
 </record>
 <record id="action_booking_quick_wizard" model="ir.actions.act_window">
  <field name="name">حجز سريع</field><field name="res_model">qimam.booking.quick.wizard</field><field name="view_mode">form</field><field name="target">new</field>
 </record>
</odoo>
