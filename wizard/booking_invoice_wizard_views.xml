<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_booking_invoice_wizard" model="ir.ui.view">
  <field name="name">qimam.booking.invoice.wizard.form</field>
  <field name="model">qimam.booking.invoice.wizard</field>
  <field name="arch" type="xml">
   <form string="إنشاء فاتورة الحجز">
    <group>
     <field name="booking_id"/>
     <field name="invoice_type"/>
     <field name="deposit_percent" attrs="{'invisible':[('invoice_type','!=','deposit')], 'required':[('invoice_type','=','deposit')]}"/>
    </group>
    <group string="معاينة">
     <field name="already_invoiced_percent" widget="percentage"/>
     <field name="invoice_percent" widget="percentage"/>
     <field name="preview_amount"/>
    </group>
    <div class="alert alert-info" role="alert">
     الفاتورة تُنشأ كمسودة للمراجعة. الترحيل والدفع يظلان من محاسبة Odoo القياسية.
    </div>
    <footer>
     <button name="action_create_invoice" type="object" string="إنشاء مسودة الفاتورة" class="btn-primary"/>
     <button string="رجوع" special="cancel" class="btn-secondary"/>
    </footer>
   </form>
  </field>
 </record>
</odoo>
