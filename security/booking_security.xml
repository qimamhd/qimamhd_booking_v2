<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_qimam_booking" model="ir.module.category">
            <field name="name">Qimam Booking</field>
            <field name="sequence">30</field>
        </record>

        <record id="group_booking_user" model="res.groups">
            <field name="name">Booking User</field>
            <field name="category_id" ref="module_category_qimam_booking"/>
        </record>
        <record id="group_booking_supervisor" model="res.groups">
            <field name="name">Booking Supervisor</field>
            <field name="category_id" ref="module_category_qimam_booking"/>
            <field name="implied_ids" eval="[(4, ref('group_booking_user'))]"/>
        </record>
        <record id="group_booking_manager" model="res.groups">
            <field name="name">Booking Manager</field>
            <field name="category_id" ref="module_category_qimam_booking"/>
            <field name="implied_ids" eval="[(4, ref('group_booking_supervisor'))]"/>
        </record>
    
        <!-- Operational isolation is branch-based, matching legacy custom_branch_13. -->
        <record id="rule_booking_branch" model="ir.rule"><field name="name">Booking: allowed branches</field><field name="model_id" ref="model_qimam_booking"/><field name="domain_force">[('branch_id','in',user.allowed_branch_ids.ids)]</field><field name="groups" eval="[(4,ref('group_booking_user'))]"/></record>
        <record id="rule_hall_branch" model="ir.rule"><field name="name">Hall: allowed branches</field><field name="model_id" ref="model_qimam_booking_hall"/><field name="domain_force">[('branch_id','in',user.allowed_branch_ids.ids)]</field><field name="groups" eval="[(4,ref('group_booking_user'))]"/></record>
        <record id="rule_period_branch" model="ir.rule"><field name="name">Period: allowed branches</field><field name="model_id" ref="model_qimam_booking_period"/><field name="domain_force">[('branch_id','in',user.allowed_branch_ids.ids)]</field><field name="groups" eval="[(4,ref('group_booking_user'))]"/></record>
        <record id="rule_service_branch" model="ir.rule"><field name="name">Service: allowed branches</field><field name="model_id" ref="model_qimam_booking_service"/><field name="domain_force">[('branch_id','in',user.allowed_branch_ids.ids)]</field><field name="groups" eval="[(4,ref('group_booking_user'))]"/></record>
        <record id="rule_package_branch" model="ir.rule"><field name="name">Package: allowed branches</field><field name="model_id" ref="model_qimam_booking_package"/><field name="domain_force">[('branch_id','in',user.allowed_branch_ids.ids)]</field><field name="groups" eval="[(4,ref('group_booking_user'))]"/></record>
        <record id="rule_resource_type_branch" model="ir.rule"><field name="name">Resource type: allowed branches</field><field name="model_id" ref="model_qimam_booking_resource_type"/><field name="domain_force">[('branch_id','in',user.allowed_branch_ids.ids)]</field><field name="groups" eval="[(4,ref('group_booking_user'))]"/></record>
        <record id="rule_resource_branch" model="ir.rule"><field name="name">Resource: allowed branches</field><field name="model_id" ref="model_qimam_booking_resource"/><field name="domain_force">[('branch_id','in',user.allowed_branch_ids.ids)]</field><field name="groups" eval="[(4,ref('group_booking_user'))]"/></record>
        <record id="rule_stay_branch" model="ir.rule"><field name="name">Stay: allowed branches</field><field name="model_id" ref="model_qimam_stay_booking"/><field name="domain_force">[('branch_id','in',user.allowed_branch_ids.ids)]</field><field name="groups" eval="[(4,ref('group_booking_user'))]"/></record>
        <record id="rule_schedule_branch" model="ir.rule"><field name="name">Schedule: allowed branches</field><field name="model_id" ref="model_qimam_booking_payment_schedule"/><field name="domain_force">[('branch_id','in',user.allowed_branch_ids.ids)]</field><field name="groups" eval="[(4,ref('group_booking_user'))]"/></record>
        <record id="rule_operation_template_branch" model="ir.rule"><field name="name">Operation template: allowed branches</field><field name="model_id" ref="model_qimam_booking_operation_template"/><field name="domain_force">[('branch_id','in',user.allowed_branch_ids.ids)]</field><field name="groups" eval="[(4,ref('group_booking_user'))]"/></record>
        <record id="rule_operation_item_branch" model="ir.rule"><field name="name">Operation item: allowed branches</field><field name="model_id" ref="model_qimam_booking_operation_item"/><field name="domain_force">[('branch_id','in',user.allowed_branch_ids.ids)]</field><field name="groups" eval="[(4,ref('group_booking_user'))]"/></record>

    <record id="rule_migration_map_branch" model="ir.rule"><field name="name">Migration map: allowed branches</field><field name="model_id" ref="model_qimam_booking_migration_map"/><field name="domain_force">[('branch_id','in',user.allowed_branch_ids.ids)]</field><field name="groups" eval="[(4,ref('group_booking_manager'))]"/></record>
<record id="rule_api_session_own" model="ir.rule"><field name="name">API session: own only</field><field name="model_id" ref="model_qimam_booking_api_session"/><field name="domain_force">[('user_id','=',user.id)]</field><field name="groups" eval="[(4,ref('group_booking_user'))]"/></record>

        <record id="rule_period_line_branch" model="ir.rule"><field name="name">Booking period line: allowed branches</field><field name="model_id" ref="model_qimam_booking_period_line"/><field name="domain_force">[('branch_id','in',user.allowed_branch_ids.ids)]</field><field name="groups" eval="[(4,ref('group_booking_user'))]"/></record>
        <record id="rule_service_line_branch" model="ir.rule"><field name="name">Booking service line: allowed branches</field><field name="model_id" ref="model_qimam_booking_service_line"/><field name="domain_force">[('branch_id','in',user.allowed_branch_ids.ids)]</field><field name="groups" eval="[(4,ref('group_booking_user'))]"/></record>
        <record id="rule_package_line_branch" model="ir.rule"><field name="name">Booking package line: allowed branches</field><field name="model_id" ref="model_qimam_booking_package_line"/><field name="domain_force">[('branch_id','in',user.allowed_branch_ids.ids)]</field><field name="groups" eval="[(4,ref('group_booking_user'))]"/></record>
</data>
</odoo>
